[Unit]
Description=Verify Master Press compact history transfer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/myservice
SuccessExitStatus=1
ExecStart=/usr/bin/flock -n /tmp/master-press-maintenance.lock /home/ubuntu/apps/myservice/.venv/bin/python3 /home/ubuntu/apps/myservice/master_press_supabase_history_verify.py
