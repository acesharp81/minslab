# Only this project's settings are loaded. Never point this at another PoC's data.
HANDOVER_DATA_DIR=./data
# Optional: shared demo access code. Use a long random value for network access.
HANDOVER_ACCESS_TOKEN=
# Optional external model. Only public/synthetic documents with explicit consent.
HANDOVER_LLM_URL=https://api.upstage.ai/v1
HANDOVER_LLM_MODEL=solar-pro4
HANDOVER_LLM_KEY=

# App-tracked list-price estimate, not provider balance or billing enforcement.
HANDOVER_LLM_BUDGET_USD=100

# Optional image-only postprocessing; own copied settings, never another project's .env at runtime.
HANDOVER_VISION_KEY=
HANDOVER_VISION_URL=https://api.openai.com/v1
HANDOVER_USAGE_GATEWAY_URL=http://poc07-openrouter-gateway:8071
HANDOVER_USAGE_METER_TOKEN=
