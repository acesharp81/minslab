# Actual API keys and production secrets live only in the repository root .env.
# The local PostgreSQL URL below is supplied automatically by scripts/with-root-env.mjs.
# Set POC09_CONVERSATION_PROVIDER=rules for offline evaluation without a Groq key.
POC09_DATABASE_URL=postgresql://poc09:poc09_local_only@127.0.0.1:18091/poc09
POC09_AI_PROVIDER=mock
POC09_CONVERSATION_PROVIDER=groq
POC09_METER_TOKEN=
POC09_METER_URL=http://127.0.0.1:18071/internal/usage-events
POC09_DECISION_PROVIDER=rules
POC09_MENU_SELECTOR_PROVIDER=rules
POC09_LLM_MODEL=openai/gpt-oss-20b
POC09_VISION_MODEL=openai/gpt-4o-mini
POC09_JEV_MODEL=typesafe/jev-1.13
POC09_MERCHANT_EMAIL=owner@demo.local
POC09_MERCHANT_PASSWORD=
POC09_SESSION_SECRET=
GROQ_API_KEY=
# Optional: legacy menu-image or Jev experiments only.
OPENROUTER_API_KEY=
