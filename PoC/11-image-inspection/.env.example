# API keys: server side only. Never commit .env.
OPENAI_API_KEY=
UPSTAGE_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
OPENAI_VISION_MODEL=gpt-5.4
OPENAI_REVIEW_MODEL=gpt-6-astra
UPSTAGE_MODEL=solar-pro4
# none: standard; low or higher enables reasoning and increases output usage.
UPSTAGE_REASONING_EFFORT=none
REASONING_EFFORT=low
IMAGE_DETAIL=high
API_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=16000
# External transfer is allowed only after the checkbox is selected per job.
EXTERNAL_API_ENABLED=true
# Central usage gateway already used by PoC7. No runtime imports from PoC7.
USAGE_GATEWAY_URL=http://127.0.0.1:18071
USAGE_METER_TOKEN=
USAGE_REQUIRE_SHARED=true
# New requests use the central HTTP ledger for OpenAI AND Solar.
SHARED_BUDGET_HTTP=true
# Keep the previous PostgreSQL connection only to settle pre-migration outbox records.
SHARED_BUDGET_DATABASE_URL=
SHARED_CREDIT_GRANT_ID=
SHARED_CREDIT_BUDGET_USD=0
SHARED_CREDIT_EXPIRES_AT=
# Legacy settlement settings; current limits and reset times are read from the gateway.
SHARED_CREDIT_MONTH_START_RENEWAL=false
SHARED_CREDIT_MONTH_END_RENEWAL=false
SHARED_CREDIT_MONTHLY_BUDGET_USD=0
# Required for OpenAI live calls when shared accounting is enforced.
SHARED_BUDGET_REQUIRED=true
# Login credentials. bootstrap.py generates passwords when first installed.
REVIEWER_PASSWORD=
ADMIN_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=18110
DATA_DIR=data
RETENTION_DAYS=30
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=24000000

# Free vision models only; no automatic paid fallback
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Same request reservations and rate limits as PoC7. Standalone: set REQUIRE_SHARED=false explicitly.
OPENROUTER_GATEWAY_URL=http://127.0.0.1:18071
OPENROUTER_REQUIRE_SHARED=true

# Bounded automatic crop reading / official-image comparison (0 disables).
AUTO_VERIFY_MAX_OBJECTS=9
AUTO_VERIFY_MAX_CALLS=3
# 문자 누락·불일치만 GPT-5.4 원본 재판독. 위 3회/9영역 한도를 함께 사용합니다.
TEXT_ROUTING_RECHECK_ENABLED=true
TEXT_ROUTING_MAX_REGIONS=3

# Independent local Korean OCR (install with scripts/setup_ocr.sh first)
# Enable after reviewing the local accuracy evaluation; default keeps the existing workflow.
OCR_ENABLED=false
OCR_PYTHON=.venv-ocr/bin/python
OCR_MAX_REGIONS=64
OCR_VISION_MAX_REGIONS=24
OCR_REASONING_EFFORT=low
OCR_HIGH_EFFORT_RECHECK=true
OCR_TIMEOUT_SECONDS=90

# CLOVA OCR: local PaddleOCR remains available without these credentials.
NAVER_OCR_API_KEY=
NAVER_OCR_API_URL=
NAVER_OCR_MONTHLY_LIMIT=100
# Set this only for calls made outside this app during the current month.
NAVER_OCR_MONTHLY_USED_OFFSET=0
NAVER_OCR_ENABLED=true

# 확대 판독: 원본 detail, 문자/손의 국소 형태 확인
VERIFICATION_REASONING_EFFORT=medium

# Strict fresh-image path: one blind batch of up to 4 text regions.
# Reuses local detector coordinates; OCR/NAVER settings stay independent.
GLYPH_AUDIT_ENABLED=true
GLYPH_AUDIT_MODEL=gpt-5.4
GLYPH_AUDIT_MAX_REGIONS=4

# Two independent readers, <=16 isolated syllables; no automatic retries.
ISOLATED_GLYPH_ENABLED=true
ISOLATED_GLYPH_SCALE=3
JAMO_ISOLATED_ENABLED=true

# 실험: 문구 유형별 균형 선택. 영역 누락은 줄었으나 검출률 개선 미확인. 기본 비활성.
TEXT_BALANCED_SELECTION=false

# 원본 획 비교: 로컬 한국어 OCR + 동봉 글꼴 형태 자산. setup_ocr.sh 설치 필요.
# 6자 이하의 수평 한글만 형태 비교하며, 미지원/미확정은 정상으로 확정하지 않음.
PIXEL_TEXT_ENABLED=true
PIXEL_TEXT_MAX_REGIONS=48
# 서로 다른 형태 후보가 있는 경우에만 GPT-5.4 최대 1회/이미지, 최대 6글자 묶음.
# PoC7 공용 일일 토큰 사용. 6.x로 자동 승격하지 않음. 재분석 시 저장 근거 재사용.
PIXEL_CONFIRM_ENABLED=true

# 원문 문자 판독과 별개의 철자 검사: 독립 OCR과 관찰이 일치한 문구만 mini 1회 묶음.
SPELLING_AUDIT_ENABLED=true

# 내부 PDF 참고 요령을 관련 객체/규칙에만 연결. 자체 추가 모델 호출 없음.
# 사례 사진은 참고 열람용이며 공식 도안/최신 사실/권리 증빙으로 사용하지 않음.
PRECHECK_GUIDANCE_ENABLED=true

# Local candidate diagnostics only: no new warnings, verdicts or external calls.
ARTIFACT_SCREEN_ENABLED=true
ARTIFACT_MAX_REGIONS=48
# Keep off until the deferred real-image/model evaluation passes.
# Uses existing shared crop limits; never escalates to a paid model.
ARTIFACT_RECHECK_ENABLED=false

# 기본 그림+분석의 손 위치 + 연결 구조 검사: 최대 2회, 3개 객체 (가림만으로 경고하지 않음)
HAND_AUDIT_ENABLED=true
HAND_AUDIT_MAX_OBJECTS=3
HAND_AUDIT_MODEL=gpt-5.4
HAND_GEOMETRY_ENABLED=true
