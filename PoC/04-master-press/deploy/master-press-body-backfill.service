[Unit]
Description=Master Press bounded article-body backfill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/myservice/PoC/04-master-press
# The history snapshot owns this lock from 01:05; skip one 10-minute body run
# rather than contending for SQLite if it is delayed.
SuccessExitStatus=1
ExecStart=/usr/bin/flock -n /tmp/master-press-maintenance.lock /home/ubuntu/apps/myservice/.venv/bin/python3 /home/ubuntu/apps/myservice/PoC/04-master-press/scripts/master_press_body_backfill.py
