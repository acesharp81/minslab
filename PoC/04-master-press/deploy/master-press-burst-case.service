[Unit]
Description=Master Press retired case Turbo worker (no-op; keep disabled)
After=network-online.target myservice.service master-press-case.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/myservice/PoC/04-master-press
ExecStart=/home/ubuntu/apps/myservice/.venv/bin/python3 -m master_press.burst_worker --stage case
Restart=always
RestartSec=10
Nice=10
CPUQuota=20%

[Install]
WantedBy=multi-user.target
