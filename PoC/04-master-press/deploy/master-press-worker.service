[Unit]
Description=Master Press pipeline worker
After=network-online.target myservice.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/myservice/PoC/04-master-press
ExecStart=/home/ubuntu/apps/myservice/.venv/bin/python3 -m master_press.worker
Restart=always
RestartSec=10
Nice=10
CPUQuota=50%
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
