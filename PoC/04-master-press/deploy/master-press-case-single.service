[Unit]
Description=Master Press OpenRouter single-case worker
After=network-online.target myservice.service master-press-case.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/myservice/PoC/04-master-press
ExecStart=/home/ubuntu/apps/myservice/.venv/bin/python3 -m master_press.case_worker --slot single
Restart=always
RestartSec=8
TimeoutStopSec=5min
Nice=8
CPUQuota=20%

[Install]
WantedBy=multi-user.target
