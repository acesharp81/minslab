[Unit]
Description=Clean Master Press short-retention operational data
After=network-online.target master-press-supabase-history-verify.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/myservice/PoC/04-master-press
SuccessExitStatus=1
ExecStart=/usr/bin/flock -n /tmp/master-press-maintenance.lock /home/ubuntu/apps/myservice/.venv/bin/python3 /home/ubuntu/apps/myservice/PoC/04-master-press/scripts/master_press_retention_cleanup.py
