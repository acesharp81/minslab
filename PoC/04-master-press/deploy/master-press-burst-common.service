[Unit]
Description=Master Press OpenRouter Turbo worker for common analysis
After=network-online.target myservice.service master-press-common.service
Wants=network-online.target
PartOf=myservice.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/myservice/PoC/04-master-press
ExecStart=/home/ubuntu/apps/myservice/.venv/bin/python3 -m master_press.burst_worker --stage common
Restart=always
RestartSec=10
TimeoutStopSec=5min
Nice=10
CPUQuota=20%

[Install]
WantedBy=multi-user.target
