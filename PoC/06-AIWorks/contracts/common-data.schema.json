{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworks.local/contracts/common-data.schema.json",
  "title": "AIWorks Common Data Record",
  "type": "object",
  "required": ["id", "label", "kind", "valueType", "versions"],
  "properties": {
    "id": {"type": "string"},
    "label": {"type": "string"},
    "kind": {"enum": ["fixed", "temporal"]},
    "valueType": {"enum": ["string", "number", "currency", "date", "quantity"]},
    "unit": {"type": ["string", "null"]},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["effectiveDate", "value", "source", "confidence"],
        "properties": {
          "effectiveDate": {"type": "string", "format": "date"},
          "value": {},
          "source": {
            "type": "object",
            "required": ["documentId", "locator"],
            "properties": {
              "documentId": {"type": "string"},
              "locator": {"type": "string"},
              "excerpt": {"type": "string"}
            }
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "recordedAt": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
