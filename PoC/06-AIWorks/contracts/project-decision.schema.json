{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworks.local/contracts/project-decision.schema.json",
  "title": "AIWorks Project Decision",
  "type": "object",
  "required": ["id", "projectId", "decisionType", "status", "summary", "scope", "decidedBy", "decidedAt"],
  "properties": {
    "id": {"type": "string", "pattern": "^decision_[a-f0-9]+$"},
    "projectId": {"type": "string"},
    "conversationId": {"type": ["string", "null"]},
    "messageId": {"type": ["string", "null"]},
    "decisionType": {"type": "string", "minLength": 1},
    "status": {"enum": ["accepted", "rejected", "superseded"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "rationale": {"type": ["string", "null"]},
    "scope": {"type": "object"},
    "documentId": {"type": ["string", "null"]},
    "documentVersionId": {"type": ["string", "null"]},
    "planId": {"type": ["string", "null"]},
    "executionId": {"type": ["string", "null"]},
    "decidedBy": {"type": "string"},
    "decidedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
