{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworks.local/contracts/project-markdown-document.schema.json",
  "title": "AIWorks Project Markdown Document",
  "type": "object",
  "required": ["id", "projectId", "title", "revision", "markdown", "markdownSha256", "versionId", "source", "factSnapshot"],
  "properties": {
    "id": {"type": "string", "pattern": "^mdoc_[a-f0-9]+$"},
    "projectId": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "markdown": {"type": "string", "minLength": 1},
    "markdownSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "versionId": {"type": "string", "pattern": "^mdver_[a-f0-9]+$"},
    "source": {
      "type": "object",
      "required": ["format", "filename", "artifactSha256", "sessionId"],
      "properties": {
        "format": {"type": "string"},
        "filename": {"type": ["string", "null"]},
        "artifactSha256": {"type": ["string", "null"]},
        "sessionId": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "factSnapshot": {"type": "object"}
  }
}
