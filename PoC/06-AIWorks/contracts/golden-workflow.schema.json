{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworks.local/contracts/golden-workflow.schema.json",
  "title": "AI Work Hub Golden Workflow",
  "type": "object",
  "required": ["contractVersion", "id", "title", "project", "intent", "sourceFiles", "expectations"],
  "properties": {
    "contractVersion": {"const": "golden-workflow/1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "project": {
      "type": "object",
      "required": ["name", "classification"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "classification": {"enum": ["public", "internal", "confidential", "personal"]}
      },
      "additionalProperties": false
    },
    "intent": {"type": "string", "minLength": 1},
    "retrievalQuestion": {"type": "string", "minLength": 1},
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "filename", "classification"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "classification": {"enum": ["public", "internal", "confidential", "personal"]}
        },
        "additionalProperties": false
      }
    },
    "expectations": {
      "type": "object",
      "required": ["plan", "retrieval", "markdown", "hwpx", "roundTrip", "auditEventTypes"],
      "properties": {
        "plan": {
          "type": "object",
          "required": ["responseType", "externalTransfer", "requiredPackageRefs"],
          "properties": {
            "responseType": {"type": "string"},
            "externalTransfer": {"type": "boolean"},
            "requiredPackageRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "retrieval": {
          "type": "object",
          "required": ["minimumSources", "requiredTerms"],
          "properties": {
            "minimumSources": {"type": "integer", "minimum": 1},
            "requiredTerms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "markdown": {
          "type": "object",
          "required": ["requiredSections", "requiredTerms", "forbiddenTerms", "minimumCitations"],
          "properties": {
            "requiredSections": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "requiredTerms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "forbiddenTerms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "minimumCitations": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "hwpx": {
          "type": "object",
          "required": ["requiredTerms", "minimumParagraphs", "minimumMappingCoverage"],
          "properties": {
            "requiredTerms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "minimumParagraphs": {"type": "integer", "minimum": 1},
            "minimumMappingCoverage": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "roundTrip": {
          "type": "object",
          "required": ["targetTerm", "replacement", "expectedRevision"],
          "properties": {
            "targetTerm": {"type": "string", "minLength": 1},
            "replacement": {"type": "string", "minLength": 1},
            "expectedRevision": {"type": "integer", "minimum": 2}
          },
          "additionalProperties": false
        },
        "auditEventTypes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
