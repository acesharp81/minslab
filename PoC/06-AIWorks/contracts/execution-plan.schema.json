{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworks.local/contracts/execution-plan.schema.json",
  "title": "AIWorks Execution Plan",
  "type": "object",
  "required": ["id", "intent", "dataPolicy", "steps", "status"],
  "properties": {
    "id": {"type": "string"},
    "intent": {"type": "string"},
    "status": {"enum": ["draft", "awaiting-approval", "running", "completed", "failed", "cancelled"]},
    "dataPolicy": {
      "type": "object",
      "required": ["classification", "externalTransfer", "maskedFields"],
      "properties": {
        "classification": {"enum": ["public", "internal", "confidential", "personal"]},
        "externalTransfer": {"type": "boolean"},
        "maskedFields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "mcp", "action", "model", "permissions"],
        "properties": {
          "id": {"type": "string"},
          "mcp": {"type": "string"},
          "action": {"type": "string"},
          "model": {"type": ["string", "null"]},
          "permissions": {"type": "array", "items": {"type": "string"}},
          "dependsOn": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
