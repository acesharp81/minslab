{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworks.local/contracts/workflow-recipe.schema.json",
  "title": "AIWorks Workflow Recipe",
  "type": "object",
  "required": ["id", "name", "visibility", "status", "versions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 120},
    "description": {"type": "string"},
    "visibility": {"enum": ["private", "organization", "public"]},
    "status": {"enum": ["published", "deprecated", "deleted"]},
    "owner": {"type": "string"},
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "definition"],
        "properties": {
          "id": {"type": "string", "pattern": "^recipever_[a-f0-9]+$"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"},
          "definition": {
            "type": "object",
            "required": ["contractVersion", "steps"],
            "properties": {
              "contractVersion": {"const": "1.0"},
              "tags": {"type": "array", "items": {"type": "string"}},
              "inputArtifactTypes": {"type": "array", "items": {"type": "string"}},
              "outputArtifactTypes": {"type": "array", "items": {"type": "string"}},
              "estimatedCost": {"type": "number", "minimum": 0},
              "estimatedLatencyMs": {"type": "integer", "minimum": 0},
              "license": {"type": "string"},
              "provenance": {"type": "string"},
              "security": {
                "type": "object",
                "required": ["status", "blocked", "advisories"]
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "required": ["id", "capability", "permissions"],
                  "properties": {
                    "id": {"type": "string"},
                    "capability": {"type": "string"},
                    "permissions": {"type": "array", "items": {"type": "string"}},
                    "input": {"type": "object"},
                    "outputArtifactType": {"type": ["string", "null"]},
                    "requiresConfirmation": {"type": "boolean"}
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "preview": {
      "type": "object",
      "required": ["tags", "permissions", "capabilities", "estimatedCost", "estimatedLatencyMs", "license", "provenance", "requiresConfirmation", "security", "riskFlags"],
      "properties": {
        "tags": {"type": "array", "items": {"type": "string"}},
        "permissions": {"type": "array", "items": {"type": "string"}},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "estimatedCost": {"type": "number", "minimum": 0},
        "estimatedLatencyMs": {"type": "integer", "minimum": 0},
        "riskFlags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "installed": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
