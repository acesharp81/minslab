{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworks.local/contracts/mcp-manifest.schema.json",
  "title": "AIWorks MCP Manifest",
  "type": "object",
  "required": ["id", "name", "version", "runtime", "inputs", "outputs", "permissions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 2},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "runtime": {"enum": ["local", "remote", "hybrid"]},
    "description": {"type": "string"},
    "mcpType": {"enum": ["template", "process", "data", "tool", "external"]},
    "derivedFrom": {"type": "string"},
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "builderGuide": {
      "type": "object",
      "required": ["version", "instructions", "cautions", "procedure", "triggerExamples", "dataSource", "useModel", "referenceRoles"],
      "properties": {
        "version": {"type": "string"},
        "instructions": {"type": "string", "minLength": 10},
        "cautions": {"type": "array", "items": {"type": "string"}},
        "procedure": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "triggerExamples": {"type": "array", "items": {"type": "string"}},
        "dataSource": {"type": "string"},
        "useModel": {"type": "boolean"},
        "referenceRoles": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "executionAdapter": {
      "type": "object",
      "required": ["kind", "version", "entrypoint", "arbitraryCode"],
      "properties": {
        "kind": {"enum": ["prompt", "composite", "retrieval", "external-mcp", "code"]},
        "version": {"type": "string"},
        "entrypoint": {"type": "string"},
        "arbitraryCode": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "ioContract": {
      "type": "object",
      "properties": {
        "inputArtifactTypes": {
          "type": "array", "items": {"type": "string"}, "uniqueItems": true
        },
        "outputArtifactTypes": {
          "type": "array", "items": {"type": "string"}, "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "reason", "required"],
        "properties": {
          "scope": {"enum": ["document.read", "document.write", "common-data.read", "common-data.write", "artifact.read", "artifact.write", "project.manage", "network.send", "model.invoke"]},
          "reason": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "supports": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "visibility": {"enum": ["private", "organization", "public"]},
    "sourceIncluded": {"type": "boolean"},
    "configuration": {
      "type": "object",
      "required": ["version", "properties", "required"],
      "properties": {
        "version": {"type": "string"},
        "properties": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 30,
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,79}$"},
          "additionalProperties": {
            "type": "object",
            "required": ["type", "title", "default"],
            "properties": {
              "type": {"enum": ["string", "boolean", "integer", "number"]},
              "title": {"type": "string", "minLength": 1},
              "description": {"type": "string"},
              "default": {},
              "enum": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true},
              "enumLabels": {"type": "object", "additionalProperties": {"type": "string"}},
              "minimum": {"type": "number"},
              "maximum": {"type": "number"},
              "maxLength": {"type": "integer", "minimum": 1, "maximum": 5000}
            },
            "additionalProperties": false
          }
        },
        "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "externalMcp": {
      "type": "object",
      "required": ["contractVersion", "transport", "toolName", "documentTransfer"],
      "properties": {
        "contractVersion": {"type": "string"},
        "transport": {"enum": ["streamable-http", "stdio"]},
        "endpointEnv": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,80}$"},
        "serverProfile": {"type": "string", "pattern": "^[a-z0-9.-]+@\\d+\\.\\d+\\.\\d+$"},
        "toolName": {"type": "string", "minLength": 2},
        "invocationAdapter": {"enum": ["markdown-output-hwpx", "hwpx-markdown-output", "hwpx-form-output"]},
        "preset": {"type": "string"},
        "inputMap": {"type": "object", "additionalProperties": {"type": "string"}},
        "outputContentPath": {"type": "string"},
        "outputFilenamePath": {"type": "string"},
        "documentTransfer": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"transport": {"const": "stdio"}}},
          "then": {"required": ["serverProfile", "invocationAdapter"], "properties": {"documentTransfer": {"const": false}}},
          "else": {"required": ["endpointEnv", "inputMap", "outputContentPath", "outputFilenamePath"], "properties": {"documentTransfer": {"const": true}}}
        }
      ],
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "required": ["kind", "chunkSize", "chunkOverlap", "topK", "citationRequired"],
      "properties": {
        "kind": {"const": "local-rag"},
        "chunkSize": {"type": "integer", "minimum": 200, "maximum": 4000},
        "chunkOverlap": {"type": "integer", "minimum": 0, "maximum": 1000},
        "topK": {"type": "integer", "minimum": 1, "maximum": 8},
        "citationRequired": {"const": true}
      },
      "additionalProperties": false
    }
    ,"references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "filename", "mediaType", "bytes", "sha256"],
        "properties": {
          "id": {"type": "string"},
          "filename": {"type": "string"},
          "mediaType": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "role": {"enum": ["template-source", "guide", "sample-input", "sample-output", "data-source", "data-schema"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
