# 프로젝트 전용 비밀값과 로컬 런타임
.env
.env.*
!.env.example
.venv/
venv/
.runtime/
node_modules/

# 캐시·빌드·테스트 산출물
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.next/
dist/
build/
coverage/
.coverage
htmlcov/
*.tsbuildinfo
*.log

# 데이터와 백업은 폴더 표시 파일만 추적
data/*
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
backups/
