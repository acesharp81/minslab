# HOME (PoC 10) 전용 설정. 실제 값은 이 폴더의 .env에 보관합니다.
POC10_DB_PASSWORD=replace_with_random_password
POC10_INTERNAL_SECRET=replace_with_random_secret
POC10_AUTO_COLLECT=true
POC10_COLLECTION_INTERVAL_SECONDS=86400
# Docker Compose가 DB URL을 주입합니다. 로컬 실행 시에만 직접 설정합니다.
# POC10_DATABASE_URL=postgresql+psycopg://home:PASSWORD@127.0.0.1:18101/home
# 부모 서비스 전용 설정 (선택, 기본값 사용 가능)
# POC10_UPSTREAM=http://127.0.0.1:18100
# API 확대 표본은 관리자 요청 또는 scripts.collect --samples로 수집합니다.
# 신청·이용 안내: https://www.data.go.kr/data/15098547/openapi.do
POC10_CHEONGYAK_SERVICE_KEY=
# 신청·이용 안내: https://www.data.go.kr/data/15136560/openapi.do
POC10_BUILDING_HUB_SERVICE_KEY=
# 일반 건축인허가 활용신청: https://www.data.go.kr/data/15136267/openapi.do
# 아래 값은 선택 사항. 비워두면 기존 POC10_BUILDING_HUB_SERVICE_KEY를 재사용합니다.
POC10_GENERAL_BUILDING_SERVICE_KEY=
# 최초 연계는 법정동 1개씩 전체 페이지를 확인합니다. 최대 5개.
POC10_GENERAL_PERMIT_DONGS_PER_BATCH=1
# 대량 보완 작업에서만 조정. 페이지 검증·원천별 잠금은 유지됩니다.
POC10_GENERAL_PERMIT_QUERY_WORKERS=1
POC10_BUILDING_DETAIL_QUERY_WORKERS=1
# apis.data.go.kr 요청 간격(초, 프로세스 공통). 429는 Retry-After에 따라 대기합니다.
POC10_API_REQUEST_INTERVAL=0.35
POC10_FETCH_ATTEMPTS=3
# 주택인허가 동별·대지위치 파일럿 수집: 서울·경기 법정동 10자리 코드 1~8개
# 같은 POC10_BUILDING_HUB_SERVICE_KEY를 사용하며 별도 키 신청은 불필요합니다.
POC10_BUILDING_DETAIL_DONGS_PER_BATCH=8
# 신청·이용 안내: https://www.vworld.kr/v4po_openapi_s001.do
POC10_VWORLD_API_KEY=
# 추가 서비스: 활용승인과 수집기 연결이 필요합니다. 키만 입력하면 수집되지 않습니다.
# 건축물대장정보 15134735 (기존 주택인허가와 별도 활용신청)
# 신청·이용 안내: https://www.data.go.kr/data/15134735/openapi.do
POC10_BUILDING_REGISTER_SERVICE_KEY=
# 공공임대 공고 보완 15058530
# 신청·이용 안내: https://www.data.go.kr/data/15058530/openapi.do
POC10_LH_NOTICE_SERVICE_KEY=
# 지역 전체 인허가·착공·준공 통계 대조 (정책 실적에 직접 합산하지 않음)
# 신청·이용 안내: https://stat.molit.go.kr/portal/api/info.do
POC10_MOLIT_STAT_API_KEY=
# SH 파일 변환 Open API: 15008820 / 15124798 각각 활용신청 후 승인된 공공데이터포털 키
# 신청·이용 안내: https://www.data.go.kr/data/15008820/fileData.do | https://www.data.go.kr/data/15124798/fileData.do
POC10_SH_SERVICE_KEY=
# 아래 서울·경기 키는 각 지역 포털용 선택 항목이며 SH ODcloud 키와 구분합니다.
# 신청·이용 안내: https://data.seoul.go.kr/together/guide/useGuide.do
POC10_SEOUL_OPEN_API_KEY=
# 신청·이용 안내: https://data.gg.go.kr/portal/openapi/usagePage.do
POC10_GG_OPEN_API_KEY=
# 모니터링 사업의 정책 기원 연도(현재 2018년)부터 연도·지역별 수집
# 시작일을 생략하면 정책 기원에서 계산합니다. 이후 날짜로 설정해도 기원 연도는 유지합니다.
POC10_NOTICE_START_DATE=2018-01-01
# 0 = 법정동별 전체 조회 페이지, 명시한 양수는 표본 제한 (안전 상한 10,000)
POC10_PERMIT_DISTRICT_LIMIT=0
POC10_GEOCODE_PER_KIND_REGION=10

# 서울·경기 전체 법정동 이어받기: 배치별 동 수 (1~20)
POC10_BUILDING_DONGS_PER_BATCH=20

# LH 과거 공개 파일 3종: 추가 API 키 불필요 (홈페이지 첨부·공개 CSV 수집)
# 공공분양 공급현황: https://www.lh.or.kr/board.es?act=view&bid=0007&list_no=727605&mid=a10103040000
# 연간 입주계획: https://www.lh.or.kr/board.es?act=view&bid=0007&list_no=654827&mid=a10103010000
# 단지정보: https://www.data.go.kr/data/15080989/fileData.do
# 서울·경기 포털 키는 선택 항목. 대상 API 원천 확정 전에는 파일 수집과 별도 관리.
# 지역 배경 통계: SGIS 인구·가구·사업체·산업 종사자
# 신청: https://sgis.mods.go.kr/developer/html/newOpenApi/api/dataApi/census.html
POC10_SGIS_CONSUMER_KEY=
POC10_SGIS_CONSUMER_SECRET=
# KOSIS 시군구 고용·시도 장래가구추계
# 신청: https://kosis.kr/openapi/devGuide/devGuide_0201List.do
POC10_KOSIS_API_KEY=

# Optional iH Incheon rental supply service; separate service approval required.
# https://www.data.go.kr/data/15168460/openapi.do
POC10_IH_SERVICE_KEY=
