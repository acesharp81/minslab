<script>
(function () {
  var COPY_SUFFIX_TEMPLATE =
    "\n[출처] - {SOURCE}\n[원본링크] - {URL}";
  var SOURCE_NAME   = "뉴시스";
  var ORIGINAL_URL  = "";
  var MIN_LENGTH    = 1;

  function safeGetSelectionText() {
    try {
      if (window.getSelection) {
        var sel = window.getSelection();
        return sel ? String(sel.toString()) : "";
      }
      // 구형 IE (문서 selection 객체)
      if (document.selection && document.selection.type !== "Control") {
        return document.selection.createRange().text || "";
      }
    } catch (e) {
      // 어떤 경우에도 페이지 스크립트를 깨뜨리지 않아야함.
    }
    return "";
  }

  function buildAppendedText(originalText) {
    try {
      var url = ORIGINAL_URL && ORIGINAL_URL.length > 0
        ? ORIGINAL_URL
        : (typeof location !== "undefined" && location.href ? location.href : "");

      var suffix = COPY_SUFFIX_TEMPLATE
        .split("{SOURCE}").join(SOURCE_NAME)
        .split("{URL}").join(url)
        .split("{TEXT}").join(originalText);

      return originalText + suffix;
    } catch (e) {
      return originalText; // 조립 실패 시 원본 텍스트만 반환
    }
  }

  function handleCopy(e) {
    try {
      var event = e || window.event;
      var selectedText = safeGetSelectionText();

      if (!selectedText || selectedText.length <= MIN_LENGTH) {
        // 조건 미충족: 기본 복사 동작 그대로 둠
        return;
      }

      var finalText = buildAppendedText(selectedText);

      // 최신 브라우저 (Chrome, Firefox, Safari, Edge 등)
      if (event && event.clipboardData && event.clipboardData.setData) {
        event.clipboardData.setData("text/plain", finalText);
        event.preventDefault();
        return;
      }

      // 구형 IE (IE9~11)
      if (window.clipboardData && window.clipboardData.setData) {
        window.clipboardData.setData("Text", finalText);
        if (event && event.preventDefault) {
          event.preventDefault();
        } else if (event) {
          event.returnValue = false;
        }
        return;
      }

      // 둘 다 지원하지 않는 환경: 아무 것도 하지 않고 기본 동작 유지
    } catch (err) {
      // 어떤 예외가 발생해도 페이지의 다른 스크립트/기능에 영향 없음
    }
  }

  /* 이벤트 바인딩 (구형 브라우저 fallback 포함) */
  try {
    if (document.addEventListener) {
      document.addEventListener("copy", handleCopy, false);
    } else if (document.attachEvent) {
      // IE8 이하
      document.attachEvent("oncopy", handleCopy);
    }
  } catch (bindErr) {
    // 바인딩 실패해도 조용히 무시
  }
})();
</script><div class="viewBox">
