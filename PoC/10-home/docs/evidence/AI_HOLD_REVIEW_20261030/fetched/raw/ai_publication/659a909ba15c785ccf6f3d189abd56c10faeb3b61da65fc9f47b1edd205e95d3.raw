<script type="text/javascript">
function escapeHtml(str) {
    if (typeof str !== 'string') {
		return str;
    }

    const entityMap = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#x27;',
      '/': '&#x2F;'
    };

    // &, <, >, ", ', / 문자를 글로벌(/g)로 찾아 치환
    return str.replace(/[&<>"'/]/g, (match) => entityMap[match]);
}
function searchSubmit() {
    var searchWord = escapeHtml(document.getElementById('krds_globalSearch').value);
    var searchType = '통합검색';

    // URL 생성
    var searchUrl = '/search/search2023.jsp?search_type=' 
                    + encodeURIComponent(searchType)
                    + '&searchWord=' + encodeURIComponent(searchWord)
                    + '&query=' + encodeURIComponent(searchWord)
                    + '&ADM_NM=';

    // 새로운 URL로 이동
    window.location.href = searchUrl;
}

function searchWordKeyPress(event) {
    if (event.key === 'Enter') {
        searchSubmit();
        return false;
    }
    return true;
}
</script>
