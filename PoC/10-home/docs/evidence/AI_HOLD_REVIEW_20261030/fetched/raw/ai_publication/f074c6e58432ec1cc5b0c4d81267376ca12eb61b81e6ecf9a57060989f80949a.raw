<script src="//developers.kakao.com/sdk/js/kakao.min.js"></script>
<script src="https://cdn.daily.hankooki.com/script/share.sns.js"></script>
<script>
	var site_ismobile		= '';			// 현재 모바일접속 여부
	var kakaojavascriptkey	= '2d2526de0cc67be315281759ba8480b0';	// 카카오앱 자바스크립트키
	var articleIdxno		= '1412715';

	$(document).ready(function(e) {

		if(kakaojavascriptkey) kakaoinit(kakaojavascriptkey);
		var sns_clipboard = new Clipboard('.sns_clipboard');
		sns_clipboard.on('success', function(e) {
			alert("클립보드에 복사되었습니다. \nCtrl+v해서 원하는 곳에 붙여넣으세요.");
		});

		$('button.sns-share-btns').on('click', function(e) {
			var sns		= $(this).data('sharesns');
			var title	= $(this).data('title');
			var desc	= $(this).data('desc');
			var url		= $(this).data('url');
			var img		= $(this).data('image');

			if(sns == "link") return true;

			// SNS 공유 통계 집계 (공유하기에 영향을 주지않도록 체크하지는 않음)
			snsShareStats(articleIdxno, sns);

			if(sns == "kakao") {
				sendKakaoTalk(url, title, desc, img);
			}else if(sns == "kakaostory") {
				shareStory(url, title, desc, img);
			}else if(sns == "band") {
				shareBand(url, title);
			}else if(sns == "telegram") {
                shareTelegram(url, title);
			}else{
				shareOtherSNS(sns, title, url, img);
			}
		});
	});
</script>
<style type="text/css">
/* edit skin css START */
#user-container[class*="width-"] {width:auto}
#article-view .article-view-content {display:-ms-flexbox;display:flex;-ms-flex-wrap:wrap;flex-wrap:wrap}
#article-view .article-view-content > .grid.body {-ms-flex-preferred-size:0;flex-basis:0;-ms-flex-positive:1;flex-grow:1;max-width:100%;min-width:0}
#article-view .article-view-content > .grid.side {-ms-flex:0 0 350px;flex:0 0 350px;max-width:350px;padding-left:50px}
#article-view .article-veiw-body {margin-top:3.125rem}
#article-view .sticky {position:static !important;top:auto !important;bottom:auto !important;max-width:none !important;margin:0 !important}
@media screen and (max-width: 63.9375em) {
	.row #article-view .article-view-content > .grid {-ms-flex:0 0 100%;flex:0 0 100%;max-width:100%}
	.row #article-view .article-view-content > .grid.body {margin-bottom:1.875rem}
	.row #article-view .article-view-content > .grid.side {padding-left:0}
	.row #article-view .article-veiw-body {padding:0}
	.row #article-view .respons-edit > [class*="float-"] {float:none !important;width:auto !important;padding:0 !important}
	.row #article-view .respons-edit > .float-right {display:none !important}
}

/* header */
#article-view .article-view-header {margin:1rem 0 3.75rem;padding:0 0 1.5rem;border-bottom:1px solid #000}
#article-view .heading {margin-top:0;margin-bottom:1rem;font-size:2.4rem}
@media screen and (max-width: 63.9375em) {
	.row #article-view .heading {padding-right:0;font-size:2rem}
}
@media screen and (max-width: 39.9375em) {
	.row #article-view .heading {font-size:1.5rem}
}

/* info box */
#article-view .info-box {display:-ms-flexbox;display:flex;-ms-flex-wrap:wrap;flex-wrap:wrap;-ms-align-items:center;align-items:center;position:relative;margin-bottom:1rem}
#article-view .info-box > nav {-ms-flex:0 0 auto;flex:0 0 auto;width:auto;max-width:100%}
#article-view .breadcrumbs {margin-bottom:0}
#article-view .breadcrumbs li {float:none;display:inline-block;font-size:1rem;font-weight:400;font-weight:var(--wgt400);color:inherit;vertical-align:middle}
#article-view .breadcrumbs li:first-child {font-size:1rem;font-weight:700;font-weight:var(--wgt700)}
#article-view .breadcrumbs li > a {color:inherit}
#article-view .breadcrumbs li:not(:last-child)::after {content:"\e940";top:0;width:auto;margin:0 0.5rem;font-family:"fontello";font-size:inherit;font-style:normal;line-height:1}
#article-view .infomation {-ms-flex-preferred-size:0;flex-basis:0;-ms-flex-positive:1;flex-grow:1;max-width:100%;min-width:0;text-align:left}
#article-view .infomation > li {font-size:.8rem;font-weight:400;color:rgba(0,0,0,.55)}
#article-view .infomation > li::after {content:normal;display:none}
#article-view .infomation > li:not(:last-child):not(.press) {margin-right:1rem}
#article-view .infomation .press > .name {font-size:.9375rem;font-style:normal;font-weight:400;font-weight:var(--wgt400);color:#000}
#article-view .infomation .press > .name::after {content:'｜';padding:0 .625rem;color:rgba(0,0,0,.45)}
#article-view .infomation > li a {margin-left:0.25rem;font-size:.8256rem;font-weight:400;font-style:normal;line-height:1.125;color:#707070;white-space:nowrap}
#article-view .infomation i {margin-right:.125rem}

@media screen and (max-width: 63.9375em) {
	.row #article-view .info-box > nav, .row #article-view .infomation {-ms-flex:0 0 100%;flex:0 0 100%;max-width:100%}
	.row #article-view .infomation {margin-top:.625rem;text-align:left}
}
@media screen and (max-width: 39.9375em) {s
	.row #article-view .breadcrumbs li:first-child, #article-view .breadcrumbs li {font-size:1rem}
	.row #article-view .infomation {margin-left:0;margin-top:.625rem}
	.row #article-view .infomation > li {display:block}
	.row #article-view .infomation > li:not(:last-child):not(.press) {margin-right:0}
	.row #article-view .infomation > li:not(:last-child) {margin-bottom:.375rem}
	.row #article-view .infomation > li.press > .name::after {display:none}
}

/* quick-box */
#article-view .head-inner {display:-ms-flexbox;display:flex;-ms-flex-wrap:wrap;flex-wrap:wrap;-ms-align-items:center;align-items:center}
#article-view .subheading {-ms-flex-preferred-size:0;flex-basis:0;-ms-flex-positive:1;flex-grow:1;max-width:100%;min-width:0;margin:0;padding-left:0;padding-right:2rem;font-size:1.256rem;font-weight:500;font-weight:var(--wgt500);line-height:1.8;border-left:none}
#article-view .quick-box {-ms-flex:0 0 auto;flex:0 0 auto;width:auto;max-width:100%;font-size:0}
#article-view .quick-box > .tool {vertical-align:top;width:38px;height:38px;border:1px solid #CFCFCF;cursor:pointer}
/* #article-view .quick-box > .tool:last-child {border-width:1px 1px 1px 0} */ 
#article-view .quick-box .icon-printer {font-size:1.125rem}
#article-view .font-size::before {content:'가';font-weight:700;font-weight:var(--wgt700);font-style:normal}
#article-view .font-size.down::before {font-size:.875rem}
#article-view .font-size.up::before {font-size:1.125rem}
@media screen and (max-width: 63.9375em) {
	.row #article-view .subheading {font-size:1.1875rem}
}
@media screen and (max-width: 39.9375em) {
	.row #article-view .subheading, .row #article-view .quick-box {-ms-flex:0 0 100%;flex:0 0 100%;max-width:100%}
	.row #article-view .subheading {padding-right:0;font-size:1.0625rem}
	.row #article-view .quick-box.text-right {margin-top:1.25rem;text-align:left}
	.row #article-view .quick-box > .print {display:none}
}

/* article sns */
#article-view .social-group {text-align:center}
#article-view .social-group .sns {position:relative;margin:0 .08rem;width:38px;height:38px;font-size:1.256rem;color:#000;background-color:#FFF;border:1px solid #CFCFCF;cursor:pointer;}
#article-view .social-group .sns.chat > small {z-index:2;position:absolute;padding:2px 4px;top:-4px;right:0;font-size:.6875rem;color:#fff}
@media screen and (min-width: 64em) {
	#article-view .social-group .sns:hover {color:#FFF !important}
	#article-view .social-group .sns.facebook:hover {background-color:#3a5795 !important}
	#article-view .social-group .sns.twitter:hover {background-color:#0084b4 !important}
	#article-view .social-group .sns.google:hover, #article-view .social-group .sns.google-plus:hover {background-color:#db4a39 !important}
	#article-view .social-group .sns.kakao:hover {background-color:#ffdc00 !important}
	#article-view .social-group .sns.kakaostory:hover {background-color:#f9e000 !important}
	#article-view .social-group .sns.blog:hover {background-color:#2db400 !important}
	#article-view .social-group .sns.post:hover {background-color:#2db400}
	#article-view .social-group .sns.pinterest:hover {background-color:#cd1f28 !important}
	#article-view .social-group .sns.band:hover {background-color:#03cf5d !important}
	#article-view .social-group .sns.link:hover {background-color:#13c0cb !important}
	#article-view .social-group .sns.mail:hover {background-color:#ff8522 !important}
	#article-view .social-group .sns.share:hover {background-color:#47c29e !important}
	#article-view .social-group .sns.bookmark:hover {background-color:#e73f72 !important}
	#article-view .social-group .sns.chat:hover {background-color:#222 !important}
}
@media screen and (max-width: 63.9375em) {
	.row #article-view .social-group .sns {margin:0 .375rem;background-color:#fff}
}
@media screen and (max-width: 39.9375em) {
	.row #article-view .social-group .sns {display:none}
	.row #article-view .social-group .sns.link, .row #article-view .social-group .sns.mail, .row #article-view .social-group .sns.share, .row #article-view .social-group .sns.bookmark {display:inline-block}
}

/* article tag */
#article-view .tag-group {margin:5rem 0 5.625rem;padding:0 1rem;text-align:center}
#article-view .tag-group .tag:not(:last-child) {margin-right:.25rem}
#article-view .tag-group .tag {margin-bottom:4px;padding:3px 12px;font-size:.9375rem;font-weight:300;line-height:1.5;color:#222;background-color:#fff;border:1px solid #222;text-decoration:none}
#article-view .tag-group .tag:hover {color:#fff;background-color:#222}

/* article footer */
#article-view .writer {display:-ms-flexbox;display:flex;-ms-flex-wrap:wrap;flex-wrap:wrap;-ms-align-items:center;align-items:center;margin-top:5.625rem;padding-bottom:1.875rem;border-top:none;border-bottom:1px solid #1e1e1e}
#article-view .writer .image {-ms-flex:0 0 72px;flex:0 0 72px;max-width:72px;margin-right:1.5rem;height:72px;background-repeat:no-repeat;background-position:center;background-size:cover;border-radius:50%;border:1px solid #eee}
#article-view .name-text {-ms-flex-preferred-size:0;flex-basis:0;-ms-flex-positive:1;flex-grow:1;max-width:100%;min-width:0}
#article-view .name-text > .name {display:block;margin-bottom:.375rem;font-size:1.125rem;font-weight:500;font-weight:var(--wgt500);font-style:normal}
#article-view .article-more {font-size:.875rem;font-weight:300;color:rgba(0,0,0,.85);background-image:none;border-bottom:1px solid #000;transition:none;white-space:nowrap}
#article-view .article-more:hover {color:rgba(0,0,0,.85);background-image:none}
#article-view .share.flex {-ms-flex:0 0 auto;flex:0 0 auto;width:auto;max-width:100%;cursor:pointer}
#article-view .share.flex > * {display:inline-block;vertical-align:middle}
#article-view .share.flex > span {margin-right:1rem;font-size:.875rem}
#article-view .share.flex > i[class^="icon-"] {width:42px;height:42px;font-size:1.5rem;line-height:40px;border:1px solid #D5D5D5;border-radius:50%}
