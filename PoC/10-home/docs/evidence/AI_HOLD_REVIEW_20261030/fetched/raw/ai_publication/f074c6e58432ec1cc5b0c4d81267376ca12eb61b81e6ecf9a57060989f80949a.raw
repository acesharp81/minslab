<script type="text/javascript">
// back to the top
$(document).scroll(function(){
	var sDocumentHeight = $(document).height() - $(window).height();
	if($(document).scrollTop() > 0){
		$('#back-to-top').fadeIn();
	}else{
		$('#back-to-top').fadeOut();
	}
});

$('#back-to-top, a[href="#top"]').click(function(){
	$('html, body').animate( {scrollTop:0}, 100);
});
</script>



