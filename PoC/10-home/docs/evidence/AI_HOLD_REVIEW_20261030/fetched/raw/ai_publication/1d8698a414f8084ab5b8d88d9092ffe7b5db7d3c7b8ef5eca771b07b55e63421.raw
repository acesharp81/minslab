<script>
		//#view/1111 hash로 넘어올경우 파라메터로 전환
		document.addEventListener("DOMContentLoaded", function () {
			
			const url = new URL(window.location.href);
			
			if(!url.hash) return;
			if(url.searchParams.has("nttNo")) return;
			
			const hash = url.hash.substring(1);
			// hash 안에 ?가 있는지 확인
			const [hashPath, hashQuery] = hash.split("?");
			
			const parts = hashPath.split("/");
			//const parts = url.hash.substring(1).split("/");
			if(parts[0] !== "view" || parts.length !== 2) return;
			
			const nttNo = parts[1];
			if (!nttNo) return;
			
			// hash 안의 쿼리 파라미터가 있으면 전부 옮김
			if (hashQuery) {
			  const hashParams = new URLSearchParams(hashQuery);
			  hashParams.forEach((value, key) => {
			    url.searchParams.set(key, value);
			  });
			}
			
			url.searchParams.set('nttNo',nttNo); // nttNo 세팅
			url.hash = '';	// hash 제거
			
			window.location.href = url.toString();
		
		});
	</script>
	
	<div id="seoulboard_preloading" style="position:fixed;top:0px;left:0px;right:0px;bottom:0px;height:100%;z-index:1000;width:100%;text-align:center;"><img src="https://seoulboard.seoul.go.kr/humanframe/front/assets/seoul-common/assets/images/ajax-loader.gif" alt="로딩중입니다." style="position:absolute;top:50%;left:50%;z-index:1000;margin:-16px 0px 0px -16px;"></div>
	
		
		
			<!-- start:header -->
	<script>
(function () {

  /* ===============================
     CSS 로드
  =============================== */
  function includeCss(href) {
    if (document.querySelector('link[rel="stylesheet"][href="' + href + '"]')) return;

    var link = document.createElement("link");
    link.rel  = "stylesheet";
    link.type = "text/css";
    link.href = href;
    link.onerror = function () {
      console.warn("CSS load fail:", href);
    };

    (document.head || document.body).appendChild(link);
  }

  var cssList = [
    "https://seoulboard.seoul.go.kr/humanframe/front/assets/seoul-common/assets/plugin/jquery/jquery-ui-1.12.0/jquery-ui.min.css",
    "https://seoulboard.seoul.go.kr/humanframe/front/assets/seoul-common/assets/plugin/jquery/jquery.datetimepicker.css",
    "https://seoulboard.seoul.go.kr/humanframe/front/assets/seoul-common/assets/css/seoul-board-style.css",
    "https://seoulboard.seoul.go.kr/humanframe/front/assets/seoul-common/assets/css/seoul-board-style-responsive.css"
  ];

  for (var c = 0; c < cssList.length; c++) {
    includeCss(cssList[c]);
  }


  /* ===============================
     JS 안전 로더 (병렬)
  =============================== */
  function includeJs(src, callback, timeoutMs) {

    timeoutMs = timeoutMs || 5000;

    if (document.querySelector('script[src="' + src + '"]')) {
      if (callback) callback(null);
      return;
    }

    var script = document.createElement("script");
    script.type = "text/javascript";
    script.src  = src;
    script.charset = "UTF-8";
    script.async = true;   // ✅ 병렬 로딩

    var done = false;

    function finish(err) {
      if (done) return;
      done = true;
      clearTimeout(timer);
      if (callback) callback(err);
    }

    script.onload = function () { finish(null); };
    script.onerror = function () { finish(new Error("LOAD FAIL: " + src)); };

    var timer = setTimeout(function () {
      finish(new Error("TIMEOUT: " + src));
    }, timeoutMs);

    (document.head || document.body).appendChild(script);
  }


  /* ===============================
     병렬 로딩 유틸
  =============================== */
  function loadJsParallel(list, done) {

    if (!list || list.length === 0) {
      if (done) done();
      return;
    }

    var remain = list.length;

    list.forEach(function (src) {
      includeJs(src, function (err) {
        if (err) {
          console.warn(err.message);
        }
        remain--;
        if (remain === 0 && done) done();
      });
    });
  }


  /* ===============================
     DOM Ready
  =============================== */
  function onReady(fn) {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", fn);
    } else {
      fn();
    }
  }


  /* ===============================
     JS 목록
  =============================== */
  var jsList = [
      "https://seoulboard.seoul.go.kr/humanframe/front/assets/seoul-common/assets/script/xdomain.min.js",
      "https://seoulboard.seoul.go.kr/humanframe/front/assets/seoul-common/assets/script/doT.min.js",
      //"https://www.seoul.go.kr/res_newseoul/js/kakao.min.js",

      /*로컬에서만 사용*/
      /*
      "https://www.seoul.go.kr/res_newseoul/js/jquery-3.3.1.min.js",
      "https://www.seoul.go.kr/res_newseoul/js/jquery-ui.min.js",
      */

      //"https://seoulboard.seoul.go.kr/humanframe/front/assets/seoul-common/assets/plugin/jquery/jquery.form.min.js",
      "https://seoulboard.seoul.go.kr/humanframe/front/assets/seoul-common/assets/plugin/jquery/jquery.datetimepicker.js",
      //"https://101.livere.co.kr/js/livere8_lib.js" 라이브리 사용안함
    ];

  /* ===============================
     초기화 함수
  =============================== */
  function initBbs() {

    onReady(function () {

      if (window.$ && $.datepicker) {
	   	  $.datepicker.setDefaults ({
				dateFormat : 'yy-mm-dd',
				prevText: '이전 달',
			    nextText: '다음 달',
				monthNames : ['1월', '2월', '3월', '4월', '5월', '6월', '7월', '8월', '9월', '10월', '11월', '12월'],
				monthNamesShort: ['1월', '2월', '3월', '4월', '5월', '6월', '7월', '8월', '9월', '10월', '11월', '12월'],
				dayNames : ['일', '월', '화', '수', '목', '금', '토'],
				dayNamesShort : ['일', '월', '화', '수', '목', '금', '토'],
				dayNamesMin : ['일', '월', '화', '수', '목', '금', '토'],
				showMonthAfterYear : true,
				yearSuffix : '년',
	            changeMonth: true,
	            changeYear: true,
	            showButtonPanel: true,
	            //showOn: "button",
	            buttonImage: "/humanframe/theme/developers/assets/img/icon/icon_calendar.png",
	            buttonImageOnly: true,
	            currentText: '오늘',
	            closeText: '닫기'
			});

	   	  $('.sib-datepicker input').datepicker();
      }

      /* info 레이어 */
		const etcInfoItems = document.querySelectorAll('.sib-etc-info');
		// PC 여부 체크
		const isPc = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

		etcInfoItems.forEach(function (item) {
			const infoIcon = item.querySelector('.sib-ico-info');
			const etcLayer = item.querySelector('.sib-etc-layer');

			if (!infoIcon || !etcLayer) return;
			function showLayer() {
				etcLayer.style.display = 'block';
			}
			function hideLayer() {
				etcLayer.style.display = 'none';
			}
			if (isPc) {
				// PC: 마우스 오버 시 보이기
				infoIcon.addEventListener('mouseenter', function () {
					showLayer();
				});
				// PC: 아이콘 또는 레이어 밖으로 나가면 숨기기
				item.addEventListener('mouseleave', function () {
					hideLayer();
				});
			} else {
				// 모바일: 아이콘 클릭 시 보이기/숨기기
				infoIcon.addEventListener('click', function (event) {
					event.preventDefault();
					event.stopPropagation();
					const isVisible = etcLayer.style.display === 'block';

					// 다른 레이어 닫기
					document.querySelectorAll('.sib-etc-layer').forEach(function (layer) {
						layer.style.display = 'none';
					});
					// 현재 레이어 토글
					etcLayer.style.display = isVisible ? 'none' : 'block';
				});
				// 레이어 내부 클릭 시 닫히지 않게
				etcLayer.addEventListener('click', function (event) {
					event.stopPropagation();
				});
			}
		});

		// 모바일: 바깥 클릭 시 전체 닫기
		if (!isPc) {
			document.addEventListener('click', function () {
				document.querySelectorAll('.sib-etc-layer').forEach(function (layer) {
					layer.style.display = 'none';
				});
			});
		}

      // 로딩 제거
      var preloading = document.getElementById('seoulboard_preloading');
      if (preloading) preloading.style.display = 'none';

      var board = document.getElementById('seoul-common-board');
      if (board) board.style.display = '';

      // JSP title 유지
      
          document.title = "보도자료 | 서울특별시";
        

    });
  }


  /* ===============================
     병렬 로딩 후 init 실행
  =============================== */
  loadJsParallel(jsList, initBbs);

})();
</script>
<!-- end:header -->

	<!-- start:content -->
	<!-- 외부 접근 금지 -->



<!-- 기타필드 항목 -->
<div id="seoul-common-board" style="display:none;">
		<div id="seoul-integrated-board" style="width: 912px;">

			<!-- 검색 시작-->
			













<script>

	const bbsNo = "158";

	function fnInit(){
		document.getElementById("srchBeginDt").value="";
		document.getElementById("srchEndDt").value="";
		document.getElementById("srchCtgryType").value="";
		document.getElementById("srchKey").value="";
		document.getElementById("srchText").value="";
		document.getElementById("srchEtc1").value="";
		document.getElementById("srchEtc2").value="";
		if(document.getElementById("srchMore")){
			document.getElementById("srchMore").checked = false;
		}

		var groups = document.querySelectorAll(".sib-frm-line[data-target]");
		groups.forEach(function (group) {
			clearSelection(group);
		});

		fnTBbsPage(1);
	}

	function fnTBbsPage(page){

		fnSetSearchEtc();

		var param = fnBbsGetParamCheck(page);

		if(param != ""){
			location.href = "?bbsNo="+bbsNo+param;
		}else{
			location.href = "?bbsNo="+bbsNo;
		}
	}

	function fnBbsGetParamCheck(page){

		let param = "";

		let curPage = "1";
		if(isNaN(page) == false && page != ""){
			if( 6422 > page){
				curPage = page;
			}else{
				curPage = "6422";
			}
		}

		let cntPerPage = document.getElementById("cntPerPage") == null ? "" : document.getElementById("cntPerPage").value; //$("#cntPerPage").val();

		let schTy = "";
		let schData = "";
		let srchBeginDt = document.getElementById("srchBeginDt") == null ? "" : document.getElementById("srchBeginDt").value; //$("#srchBeginDt").val();
		let srchEndDt = document.getElementById("srchEndDt") == null ? "" : document.getElementById("srchEndDt").value; //$("#srchEndDt").val();
		let srchCtgryType = document.getElementById("srchCtgryType") == null ? "" : document.getElementById("srchCtgryType").value; //$("#srchCtgryType").val();
		let srchKey = document.getElementById("srchKey") == null ? "" : document.getElementById("srchKey").value; //$("#srchKey").val();
		let srchText = document.getElementById("srchText") == null ? "" : document.getElementById("srchText").value; //$("#srchText").val();

		let srchEtc1 = document.getElementById("srchEtc1") == null ? "" : document.getElementById("srchEtc1").value; //$("#srchEtc1").val();
		let srchEtc2 = document.getElementById("srchEtc2") == null ? "" : document.getElementById("srchEtc2").value; //$("#srchEtc2").val();

		if(srchBeginDt){
			srchBeginDt = srchBeginDt.replaceAll(".", "");
			srchBeginDt = srchBeginDt.replaceAll("-", "");
		}

		if(srchEndDt){
			srchEndDt = srchEndDt.replaceAll(".", "");
			srchEndDt = srchEndDt.replaceAll("-", "");
		}

		if(cntPerPage != "") param+= "&cntPerPage="+cntPerPage;
		if(curPage != "") param+= "&curPage="+curPage;
		if(schTy != "") param+= "&schTy="+schTy;
		if(schData != "") param+= "&schData="+schData;
		if(srchBeginDt != "") param+= "&srchBeginDt="+srchBeginDt;
		if(srchEndDt != "") param+= "&srchEndDt="+srchEndDt;
		if(srchCtgryType != "") param+= "&srchCtgryType="+srchCtgryType;
		if(srchKey != "") param+= "&srchKey="+srchKey;
		if(srchText != "") param+= "&srchText="+srchText;
		if(srchEtc1 != "") param+= "&srchEtc1="+srchEtc1;
		if(srchEtc2 != "") param+= "&srchEtc2="+srchEtc2;

		if(document.getElementById("srchMore") != null){
			if(document.getElementById("srchMore").checked == true){
				param+= "&srchMore=Y";
			}
		}

		return param;
	}

	function fnTbbsView(nttNo){

		page = "";
		var param = fnBbsGetParamCheck(page);

		if(isNaN(nttNo) == false && nttNo != ""){
			if(param != ""){
				location.href = "?bbsNo="+bbsNo+"&nttNo="+nttNo+param;
			}else{
				location.href = "?bbsNo="+bbsNo+"&nttNo="+nttNo;
			}
		}

	}

	/* 다중선택 클릭 처리 */
	function initMultiSelectFilter() {
		var groups = document.querySelectorAll(".sib-frm-line[data-target]");
		groups.forEach(function (group) {
			var links = group.querySelectorAll(".sib-frm-items a, .sib-frm-items .sib-etc-info a");
			links.forEach(function (link) {
				link.addEventListener("click", function (e) {
					e.preventDefault();
					toggleOption(group, this);
				});
			});
		});
	}

	function toggleOption(group, clickedLink) {
		var allLink = group.querySelector('.sib-frm-items a[data-all="Y"]');
		var normalLinks = group.querySelectorAll('.sib-frm-items a:not([data-all="Y"])');
		var isAll = clickedLink.getAttribute("data-all") === "Y";
		if (isAll) {
			clearSelection(group);
			setSelected(clickedLink, true);
		} else {
			if (allLink) {
				setSelected(allLink, false);
			}
			if (clickedLink.classList.contains("on")) {
				setSelected(clickedLink, false);
			} else {
				setSelected(clickedLink, true);
			}
			var selectedCount = 0;
			normalLinks.forEach(function (link) {
				if (link.classList.contains("on")) {
					selectedCount++;
				}
			});
			if (selectedCount === 0 && allLink) {
				setSelected(allLink, true);
			}
		}
		syncHiddenValue(group);
	}

	function clearSelection(group) {
		var links = group.querySelectorAll(".sib-frm-items a, .sib-frm-items .sib-etc-info a");
		links.forEach(function (link) {
			setSelected(link, false);
		});
	}

	function setSelected(link, isSelected) {
		if (isSelected) {
			link.classList.add("on");
			link.setAttribute("title", "선택됨");
		} else {
			link.classList.remove("on");
			link.removeAttribute("title");
		}
	}

	function syncHiddenValue(group) {
		var targetId = group.getAttribute("data-target");
		var hidden = document.getElementById(targetId);
		var selectedValues = [];
		if (!hidden) return;
		var selectedLinks = group.querySelectorAll('.sib-frm-items a.on:not([data-all="Y"])');
		selectedLinks.forEach(function (link) {
			var value = link.getAttribute("data-value");
			if (value) {
				selectedValues.push(value);
			}
		});
		hidden.value = selectedValues.join(",");
	}

	/* 검색 직전 hidden 값 세팅 */
	function fnSetSearchEtc() {
		var groups = document.querySelectorAll(".sib-frm-line[data-target]");
		groups.forEach(function (group) {
			syncHiddenValue(group);
		});
	}

	/* 검색 후 파라미터 값으로 선택 상태 복원 */
	function restoreSelectedState() {
		var groups = document.querySelectorAll(".sib-frm-line[data-target]");
		groups.forEach(function (group) {
			var targetId = group.getAttribute("data-target");
			var hidden = document.getElementById(targetId);
			var allLink = group.querySelector('.sib-frm-items a[data-all="Y"]');
			var normalLinks = group.querySelectorAll('.sib-frm-items a:not([data-all="Y"])');
			clearSelection(group);
			if (!hidden || !hidden.value || hidden.value.replace(/\s/g, "") === "") {
				if (allLink) {
					setSelected(allLink, true);
				}
				return;
			}
			var values = hidden.value.split(",");
			var matchedCount = 0;
			normalLinks.forEach(function (link) {
				var value = link.getAttribute("data-value");
				if (values.indexOf(value) > -1) {
					setSelected(link, true);
					matchedCount++;
				}
			});
			if (matchedCount === 0 && allLink) {
				setSelected(allLink, true);
			}
		});
	}
	/* 기간 버튼 */
	function initPeriodButtons() {
		var buttons = document.querySelectorAll(".sib-button-date");
		buttons.forEach(function (button) {
			button.addEventListener("click", function () {
				var period = this.getAttribute("data-period");
				setSearchPeriod(period);
				buttons.forEach(function (btn) {
					btn.classList.remove("on");
					btn.removeAttribute("title");
				});
				this.classList.add("on");
				this.title = "선택됨";
			});
		});
	}
	function setSearchPeriod(period) {
		var beginInput = document.getElementById("srchBeginDt");
		var endInput = document.getElementById("srchEndDt");
		var today = new Date();
		var beginDate = new Date(today);
		var endDate = new Date(today);
		if (period === "week") {
			beginDate.setDate(today.getDate() - 6);
		} else if (period === "month") {
			beginDate = getOneMonthAgo(today);
		}else if (period === "3month") {
			beginDate = getOneMonthAgo(today, 3);
		}
		beginInput.value = formatDate(beginDate);
		endInput.value = formatDate(endDate);
	}
	function getOneMonthAgo(baseDate, month) {
		if(month == null) month = 1;

		var d = new Date(baseDate);
		var day = d.getDate();
		d.setDate(1);
		d.setMonth(d.getMonth() - month);
		var lastDay = new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate();
		d.setDate(Math.min(day, lastDay));
		return d;
	}
	function formatDate(date) {
		var y = date.getFullYear();
		var m = ("0" + (date.getMonth() + 1)).slice(-2);
		var d = ("0" + date.getDate()).slice(-2);
		return y + "-" + m + "-" + d;
	}

	function fnMore(checked){
		if(checked == true){
			clearSelection(document.querySelector('.sib-frm-line[data-target="srchEtc1"]'));
		    setSelected(document.querySelector('.sib-frm-items a[data-value="공고"]'), true);

		    //선택 못하게
		    var srchEtc1Ele = document.querySelectorAll('.sib-frm-line[data-target="srchEtc1"] .sib-frm-items a')
		    srchEtc1Ele.forEach(function (link) {
				if (link) {
					if(link.getAttribute("data-value") != "공고"){
						link.setAttribute("style","pointer-events:none; background:#8080808c;");
					}else{
						link.setAttribute("style","pointer-events:none;");
					}

				}
			});

		}else{
			clearSelection(document.querySelector('.sib-frm-line[data-target="srchEtc1"]'));
			setSelected(document.querySelector('.sib-frm-line[data-target="srchEtc1"]>.sib-frm-items a[data-all="Y"]'), true);

			var srchEtc1Ele = document.querySelectorAll('.sib-frm-line[data-target="srchEtc1"] .sib-frm-items a')
		    srchEtc1Ele.forEach(function (link) {
				if (link) {
					link.removeAttribute("style");
				}
			});
		}

	}

	// DOM Ready (jQuery의 $(function(){}) 대체)
  	document.addEventListener("DOMContentLoaded", function () {

	    // Enter 키로 검색 실행 (이벤트 위임)
	    document.addEventListener("keydown", function (e) {
	      var t = e.target;
	      if (t && t.id === "srchText") {
	        // e.key는 구형 브라우저에서 없을 수 있어 keyCode도 같이 처리
	        if (e.key === "Enter" || e.keyCode === 13) {
	          fnTBbsPage();
	        }
	      }
	    });

	    // 버튼 클릭 시 페이지 이동 (이벤트 위임)
	    document.addEventListener("click", function (e) {
	      // button.sib-button.sib-button-go.round 매칭
	      var btn = e.target.closest && e.target.closest("button.sib-button.sib-button-go.round");
	      if (btn) {
	        var mvCurPageEl = document.getElementById("mvCurPage");
	        var curPageVal = mvCurPageEl ? mvCurPageEl.value : "";
	        fnTBbsPage(curPageVal);
	      }
	    });

	    // 숫자만 입력되도록 제한 (이벤트 위임)
	    document.addEventListener("keydown", function (e) {
	      var t = e.target;
	      if (!(t && t.id === "mvCurPage")) return;

	      var k = e.keyCode;

	      // backspace, tab, left, right, delete
	      var allowed = [8, 9, 37, 39, 46];

	      var isTopNumber   = (k >= 48 && k <= 57);
	      var isPadNumber   = (k >= 96 && k <= 105);
	      var isAllowedKey  = allowed.indexOf(k) > -1;

	      if (isTopNumber || isPadNumber || isAllowedKey) return;

	      e.preventDefault();
	    });

	    initMultiSelectFilter();
		restoreSelectedState();
		initPeriodButtons();

		//체크박스 선택여부(현재 모징중만보기)
		if(document.getElementById("srchMore")){
			if(document.getElementById("srchMore").checked == true){
				fnMore(document.getElementById("srchMore").checked);
			}
		}

  	});

</script>

