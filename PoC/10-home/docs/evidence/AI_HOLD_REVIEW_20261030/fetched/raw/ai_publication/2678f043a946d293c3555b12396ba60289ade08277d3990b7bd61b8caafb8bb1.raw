     <!--공유팝업 260622--> 
     <div class="modal fade" id="shareModal" tabindex="-1" role="dialog"> 
      <div class="modal-dialog modal modal-dialog-centered" role="document"> 
       <div class="modal-content"> 
        <div class="modal-header"> 
         <h5 class="modal-title">공유하기</h5> 
         <button type="button" class="close" data-dismiss="modal"> <span>×</span> </button> 
        </div> 
        <div class="modal-body"> 
         <a href="" class="sns_faceBook"> <img src="//cdn.emetro.co.kr/data1/resources/pc/images/btn/facebook_ico.png" alt="페이스북"> <span>페이스북</span> </a> 
         <a href="" class="sns_twitter"> <img src="//cdn.emetro.co.kr/data1/resources/pc/images/btn/twitter_ico.png" alt="트위터"> <span>트위터</span> </a> 
         <a href="" id="sns_kakaoStory"> <img src="//cdn.emetro.co.kr/data1/resources/pc/images/btn/kakao_ico.png" alt="카카오톡"> <span>카카오톡</span> </a> 
         <a href="" id="shareMail"> <img src="//cdn.emetro.co.kr/data1/resources/pc/images/btn/mail_ico.png" alt="메일"> <span>메일</span> </a> 
         <a href="" id="copyUrl"> <img src="//cdn.emetro.co.kr/data1/resources/pc/images/btn/link_ico.png" alt="url"> <span>URL 복사</span> </a> 
        </div> 
       </div> 
      </div> 
     </div> 
     <!--//공유팝업 260622--> 
     <script>
$(function () {

    // Kakao SDK 초기화
    if (!Kakao.isInitialized()) {
        Kakao.init("b0c528cc7338ab7a8788535a10965f65");
    }

    // 현재 기사 URL
    const shareUrl = window.location.href;

    // 기사 제목
    const shareTitle = $(".detail-title").text().trim();

    // 메일 공유
    $("#shareMail").on("click", function (e) {
        e.preventDefault();

        const subject = encodeURIComponent(shareTitle);
        const body = encodeURIComponent(
            shareTitle + "\n\n" + shareUrl
        );

        window.location.href = "mailto:?subject=" + subject + "&body=" + body;
    });

    // URL 복사
    $("#copyUrl").on("click", function (e) {
        e.preventDefault();

        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(shareUrl)
                .then(function () {
                    alert("URL이 복사되었습니다.");
                })
                .catch(function () {
                    fallbackCopy();
                });
        } else {
            fallbackCopy();
        }
    });

    // 구형 브라우저 대응
    function fallbackCopy() {
        var temp = document.createElement("input");
        temp.value = shareUrl;
        document.body.appendChild(temp);
        temp.select();
        temp.setSelectionRange(0, 99999);

        document.execCommand("copy");
        document.body.removeChild(temp);

        alert("URL이 복사되었습니다.");
    }

    // 카카오톡 공유
    $("#sns_kakaoStory").on("click", function (e) {
        e.preventDefault();

        Kakao.Share.sendDefault({
            objectType: "feed",
            content: {
                title: shareTitle,
                description: "",
                imageUrl: location.origin + "/resources/images/logo.png", // 기본 이미지
                link: {
                    mobileWebUrl: shareUrl,
                    webUrl: shareUrl
                }
            },
            buttons: [
                {
                    title: "기사 보기",
                    link: {
                        mobileWebUrl: shareUrl,
                        webUrl: shareUrl
                    }
                }
            ]
        });
    });

});
</script> 
    
   </div> 
    
   <div data-layout-area="ARTICLE_CONTENT" class="left-container left-article-txt layout_sortable" data-layout-area-cnt="10"> 
     
     <script>var CA = [{"sectionId":"b7208d89-4e1f-11ea-8db9-02d4480ea31a","sectionCode":"180990","sectionName":"\uBD80\uB3D9\uC0B0\uC77C\uBC18","sectionPath":"\uBD80\uB3D9\uC0B0>\uBD80\uB3D9\uC0B0\uC77C\uBC18","organizationalUnit":"\/00\/01\/CA\/180990","sectionType":"CA","sectionLevel":2}]; var SE = null;</script> 
     <input class="siteViewTitlteaa" style="display:none" value="ArticleVO(id=20261006500286, title=주택공급 목소리는 큰데…실적은 &#39;그닥&#39;, subTitle=-올 상반기 수도권 주택착공 실적 6.5만호&lt;BR&gt;-공공주택 착공도 3분기까지 1.7만호 불과, viewTitle=주택공급 목소리는 큰데…실적은 &#39;그닥&#39;, viewSubTitle=-올 상반기 수도권 주택착공 실적 6.5만호&lt;BR&gt;-공공주택 착공도 3분기까지 1.7만호 불과, mobileTitle=주택공급 목소리는 큰데…실적은 &#39;그닥&#39;, mobileSubTitle=-올 상반기 수도권 주택착공 실적 6.5만호&lt;BR&gt;-공공주택 착공도 3분기까지 1.7만호 불과, newsstandTitle=주택공급 목소리는 큰데…실적은 &#39;그닥&#39;, newsstandXMLTitle=주택공급 목소리는 큰데…실적은 &#39;그닥&#39;, imgSrc=/content/image/2026/10/06/20261006500287.jpg, content=&lt;html&gt;
 &lt;head&gt;&lt;/head&gt;
 &lt;body&gt;
  &lt;figure class=&quot;image align_center&quot;&gt; 
   &lt;img src=&quot;//cdn.emetro.co.kr/data2/content/image/2026/10/06/.cache/512/20261006500287.jpg&quot; storyid=&quot;1c48ceb0-c14a-11f1-9420-8fde8e23b15f&quot;&gt; 
   &lt;figcaption&gt;
     서울 잠수교에서 바라본 아파트 신축 현장 전경. /뉴시스 
   &lt;/figcaption&gt; 
  &lt;/figure&gt; 
  &lt;p&gt; 정부가 연일 &#39;닥공&#39;을 외치고 있지만 실제 착공으로 이어진 실적은 목표치에 크게 못 미치고 있다. 공공택지의 경우 착공기간 단축에 나섰지만 현장에서 체감되기까지는 시간이 걸릴 전망이다.&lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 6일 국토교통부에 따르면 올해 수도권 내 공공주택 착공은 3분기까지 1만7000호로 잠정 집계됐다. 올해 연간 목표 6만2000호의 27.4%에 불과한 수준이다. &lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 국토부는 앞서 지난 2일 한국토지주택공사(LH)와 서울주택도시공사(SH), 경기주택도시공사(GH), 인천도시공사(iH) 등과 함께 제3차 공공주택 공급점검 TF 회의를 갖고 3분기까지의 수도권 공공주택 착공 실적과 연말 목표 달성을 위한 추진상황을 점검했다.&lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 정부는 착공 예정 물량이 4분기에 집중된 만큼 6만호 안팎은 가능할 것이란 입장이다.&lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 국토부 관계자는 &quot;연말 착공 목표 달성을 위해 남은 기간동안 모든 역량을 집중키로 했다&quot;며 &quot;공공주택 약 4만5000호를 포함해 신축매입, 민간정비가 모두 4분기에 착공 예정 물량이 몰려 있어 최대한 실적을 끌어올릴 수 있도록 현장별로 집중 관리하겠다&quot;고 밝혔다.&lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 내년 공공부문 착공 목표 물량은 소규모 정비사업을 포함해 8만4000호 안팎이다. &lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 전체 수도권의 공급 상황도 부진을 면치 못하고 있다. &lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 정부는 앞서 8·13대책을 통해 수도권 135만호 착공 목표의 이행력을 높이고, 신규택지 10만호 등 23만호 이상 추가 공급과 공공택지 착공기간을 줄이겠다고 밝혔다.&lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 대한건설정책연구원에 따르면 올해 상반기 수도권 주택착공 누계실적은 6만5000호로 연간 목표치 26만9000호(+α) 대비 24.2% 수준에 그쳤다. 착공 선행지표인 인허가 실적은 증가세로 전환했지만 과거 평균치 대비 급감했던 작년과 비교했음을 감안하면 큰 기대를 하긴 어렵다. &lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 건정연 관계자는 &quot;연말까지 착공 목표 달성은 어려울 전망&quot;이라며 &quot;수도권 물량의 대부분을 담당하는 민간부문의 공급 동력 회복 여부가 대책 실현의 핵심 변수가 될 것&quot;이라고 분석했다.&lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 이재명 대통령은 최근 강남 매물이 많이 늘었음을 인용하며 공급이 속도를 내고 있다고 자평했다.&lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt; 
  &lt;p&gt; 이 대통령은 전일 엑스(X·옛 트위터)를 통해 &quot;22년부터 25년까지 서울 중심으로 인허가가 급감하여 시차를 두고 주택 공급물량이 대폭 줄어든 것이 단기적인 집값불안의 가장 큰 원인&quot;이라며 &quot;이 정부 들어서 얼마전부터 인허가 및 착공이 대폭 늘고 있고, 신규택지개발, 기존 부지와 건축물의 주거용 변경이 속도를 내고 있어 공급도 곧 많이 늘어날 것&quot;이라고 강조했다. &lt;/p&gt; 
  &lt;p&gt;&amp;nbsp;&lt;/p&gt;
 &lt;/body&gt;
&lt;/html&gt;, mContent=&lt;html&gt;
 &lt;head&gt;&lt;/head&gt;
 &lt;body&gt;
  &lt;figure class=&quot;image align_center&quot;&gt; 
   &lt;img src=&quot;//cdn.emetro.co.kr/data2/content/image/2026/10/06/.cache/512/20261006500287.jpg&quot; storyid=&quot;1c48ceb0-c14a-11f1-9420-8fde8e23b15f&quot;&gt; 
   &lt;figcaption&gt;
     서울 잠수교에서 바라본 아파트 신축 현장 전경. /뉴시스 
   &lt;/figcaption&gt; 
  &lt;/figure&gt; 
