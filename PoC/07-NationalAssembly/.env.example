# Application
NATIONAL_ASSEMBLY_ENV=development
NATIONAL_ASSEMBLY_HOST=0.0.0.0
NATIONAL_ASSEMBLY_PORT=8070
NATIONAL_ASSEMBLY_LOG_LEVEL=INFO
NATIONAL_ASSEMBLY_TIMEZONE=Asia/Seoul

# PostgreSQL: local compose defaults only. Change passwords outside local development.
POSTGRES_DB=national_assembly
POSTGRES_USER=national_assembly
POSTGRES_PASSWORD=CHANGE_THIS_LOCAL_PASSWORD
DATABASE_URL=postgresql://national_assembly:CHANGE_THIS_LOCAL_PASSWORD@db:5432/national_assembly

# Storage
RAW_DATA_DIR=/app/data/raw
PROCESSED_DATA_DIR=/app/data/processed

# Interest-topic alerts are deterministic and do not consume LLM tokens.
WATCH_ALERTS_ENABLED=true
# User-triggered isolated virtual broadcast for end-to-end alert testing.
WATCH_TEST_BROADCASTS_ENABLED=true
# Digest reuses stored evidence and never requires a new LLM call.
WATCH_DIGEST_ENABLED=true
# External delivery and optional watch-specific LLM remain opt-in.
WATCH_KAKAO_ENABLED=false
WATCH_LLM_ENABLED=false
WATCH_LLM_PROVIDER=openrouter
WATCH_LLM_MODEL=dots-studio/dots-3-note-preview:free
WATCH_LLM_MONTHLY_BUDGET_USD=1.0
WATCH_LLM_DEBOUNCE_SECONDS=30
WATCH_LLM_MIN_NEW_MATCHES=3
WATCH_LLM_MAX_UPDATES_PER_SESSION=12
# PoC 7 Kakao Login / Talk Message settings. These names are not shared with PoC 4.
WATCH_KAKAO_REST_API_KEY=
WATCH_KAKAO_CLIENT_SECRET=
WATCH_KAKAO_TOKEN_ENCRYPTION_KEY=
WATCH_KAKAO_REDIRECT_URI=https://www.minslab.kr/poc/national-assembly/api/watch/kakao/callback
WATCH_PUBLIC_BASE_URL=https://www.minslab.kr/poc/national-assembly/
WATCH_SESSION_COOKIE_NAME=gukjeongbomi_session
WATCH_SESSION_COOKIE_PATH=/poc/national-assembly
# On-demand topic reports: search is local (0 LLM calls), generation is one
# OpenRouter call and identical evidence/results are reused from PostgreSQL.
TOPIC_REPORTS_ENABLED=true
TOPIC_REPORT_MODEL=dots-studio/dots-3-note-preview:free
TOPIC_REPORT_DAILY_LIMIT=100
TOPIC_REPORT_USER_DAILY_LIMIT=10
TOPIC_REPORT_MAX_PERIOD_DAYS=366
# Generate a separate operator token for this PoC.
WATCH_ADMIN_TOKEN=

# Apply to the documented services with one personal/project service key.
# Never place real keys in this example file or commit the local .env.
NATIONAL_ASSEMBLY_API_KEY=

# Enable only after the selected provider key and transcript egress scope are approved.
AI_ENRICHMENT_ENABLED=0
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-2603
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Monthly free API credit and Mistral Small 4 standard API prices.
MISTRAL_MONTHLY_CREDIT_USD=10
MISTRAL_INPUT_USD_PER_MILLION=0.15
MISTRAL_OUTPUT_USD_PER_MILLION=0.60
MISTRAL_API_KEY=
EXECUTIVE_TRANSCRIPTION_MODEL=voxtral-mini-latest
EXECUTIVE_AUDIO_CHUNK_SECONDS=60
EXECUTIVE_TRANSCRIPTION_USD_PER_MINUTE=0.003
# Optional fallback provider.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DAILY_LIMIT=500
OPENROUTER_API_KEY=
# 공식 자료 반영 전후의 검증된 변경만 짧게 설명합니다. 결과는 DB에 저장합니다.
OFFICIAL_CHANGE_REPORTS_ENABLED=true
OFFICIAL_CHANGE_REPORT_MODEL=dots-studio/dots-3-note-preview:free
OFFICIAL_CHANGE_REPORT_DAILY_LIMIT=100
