# .env.local 견본 — 이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 gitignore, 값은 어디에도 올리지 않는다).
# 키 값은 공공데이터포털 '마이페이지 > 개발계정 > 일반 인증키'의 "디코딩" 값을 그대로 붙여 넣는다(+ / = 가 들어 있어도 됨, 요청할 때 한 번만 인코딩).
# 이름 규칙·고르는 방법·한도: lib/keys.js 머리말, 정본 문서: docs/product/상황판-스펙.md

# --- 용도별 키: DATA_GO_KR_KEY_<용도>_<번호> ---------------------------------
# 용도  BUILD   번들·색인 만들 때(tools/regiontools). 한도에 닿으면 다음 번호 키로 이어서 부른다
#       RESOLVE 표준코드 해석(/api/v1/resolve)
#       BUS     버스 위치 조회(/api/bus, 사용자가 버튼을 누를 때만)
#       DEMO    시연용(DATA_GO_KR_PROFILE=demo 일 때 BUS·RESOLVE 가 먼저 쓴다)
# 같은 용도의 키가 여러 개면 오늘 가장 적게 쓴 키부터 쓰고, 한도 오류를 받은 키는 한국시간 자정까지 쉰다.
DATA_GO_KR_KEY_BUILD_1=
DATA_GO_KR_KEY_BUILD_2=
DATA_GO_KR_KEY_RESOLVE_1=
DATA_GO_KR_KEY_BUS_1=
DATA_GO_KR_KEY_BUS_2=
DATA_GO_KR_KEY_DEMO_1=
DATA_GO_KR_KEY_DEMO_2=

# (선택) 그 키로 활용신청한 서비스. 쓰지 않으면 모든 서비스에 쓸 수 있다고 본다
#DATA_GO_KR_SERVICES_BUS_1=tago
#DATA_GO_KR_SERVICES_BUILD_1=hub,hubledger,stan,myhome

# (선택) 서비스별 일일 한도 재정의. 기본: tago=10000, seoul=1000, stan=10000, hub=10000, hubledger=10000(건축물대장), myhome=10000, lh=10000(LH 분양임대공고문·공급정보)
#DATA_GO_KR_LIMITS=tago=10000,seoul=1000

# (선택) 시연 프로파일: demo 로 두면 서버 용도(BUS·RESOLVE)가 DEMO 키를 먼저 쓴다
#DATA_GO_KR_PROFILE=demo

# --- 기본(호환) 키: 용도 키가 없거나 모두 한도에 닿았을 때만 쓴다 ----------------
DATA_GO_KR_KEY=

# --- V-World (지도 배경·경계·필지) ---------------------------------------------
# V-World 키는 발급할 때 등록한 서비스 URL 과 같은 domain 값을 보내야 통과한다(아니면 INCORRECT_KEY).
#   VWORLD_KEY      운영키. 서비스 URL 이 운영 도메인(housing-board.vercel.app). Vercel 환경변수에 둔다
#   VWORLD_DEV_KEY  개발키. 서비스 URL 이 localhost. 있으면 로컬 개발 서버·수집 도구(Python)가 이것을 쓴다(Vercel 에서는 쓰지 않음)
#   VWORLD_DOMAIN   로컬 .env.local 은 localhost, Vercel 은 housing-board.vercel.app
VWORLD_KEY=
VWORLD_DEV_KEY=
VWORLD_DOMAIN=localhost

# 서울시 버스 API(정류소정보조회 15000303·버스위치정보조회)와 LH 분양임대공고문(15058530)·공급정보(15056765)도 같은 공공데이터포털 키를 쓴다(키마다 서비스 활용신청이 따로 필요, 2026-10-06 현재 키는 신청 완료).
# 신청한 키에는 DATA_GO_KR_SERVICES_BUS_<N>=tago,seoul 로 표시한다(LH 는 RESOLVE 용도, 서비스 이름 lh).

# 주의: 변수 이름 앞에 NEXT_PUBLIC_ 을 붙이지 않는다(브라우저로 나간다).
# 캐시 위치(선택): CACHE_DIR=/path  (기본 로컬 .cache/, Vercel 은 os.tmpdir()/jt-cache)

# (선택) 건물 요청 시 조회(/api/v1/buildings)가 인스턴스마다 시간당 V-World 에 보낼 수 있는 쪽 수 상한. 기본 1200
#BUILDINGS_UPSTREAM_PER_HOUR=1200

# (선택) 인허가 사업 요청 시 조회(/api/v1/permits)가 인스턴스마다 시간당 V-World 필지 경계에 보낼 수 있는 호출 수 상한. 기본 2000
#PERMITS_UPSTREAM_PER_HOUR=2000

# (선택) 주소 이동 입력줄의 검색(/api/v1/codes/search)이 인스턴스마다 시간당 V-World 주소·장소 API 에 보낼 수 있는 호출 수 상한. 기본 600
#SEARCH_UPSTREAM_PER_HOUR=600

# (선택) 인허가 사업이 블록 위치·합필 지번·준공을 건축물대장(총괄표제부)으로 보강할 때 인스턴스마다 시간당 보낼 수 있는 호출 수 상한(쪽 단위). 기본 1500
#LEDGER_UPSTREAM_PER_HOUR=1500

# (선택) 기반시설 요청 시 조회(/api/v1/infra)가 인스턴스마다 시간당 TAGO 근접정류소에 보낼 수 있는 호출 수 상한. 기본 600
#INFRA_UPSTREAM_PER_HOUR=600

# (선택) 서울시 정류소정보조회(/api/v1/infra, 서울 법정동)가 인스턴스마다 시간당 보낼 수 있는 호출 수 상한. 기본 120(서울 개발계정은 하루 1,000건)
#SEOUL_UPSTREAM_PER_HOUR=120
