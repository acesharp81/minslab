APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Asia/Seoul
# Supabase 장애/오프라인 시에도 수집 결과를 잃지 않는 PoC08 전용 로컬 캐시입니다.
DATABASE_URL=sqlite:///./data/supabase-cache.db
DATA_DIR=./data
LOG_LEVEL=INFO

# 기존 서비스와 같은 Supabase Data API 자격정보만 사용합니다. DB 비밀번호/Pooler URI는 필요 없습니다.
SUPABASE2_URL=
SUPABASE2_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_SECONDS=15

# mock이면 키 없이 샘플 5건으로 전체 흐름을 실행합니다. live 전환 전 활용신청이 필요합니다.
G2B_MODE=mock
G2B_SERVICE_KEY=
G2B_BASE_URL_PRENOTICE=https://apis.data.go.kr/1230000/ao/HrcspSsstndrdInfoService
G2B_OPERATION_PRENOTICE=getPublicPrcureThngInfoServc
G2B_BASE_URL_BID=https://apis.data.go.kr/1230000/ad/BidPublicInfoService
G2B_OPERATION_BID=getBidPblancListInfoServc
G2B_OPERATION_BID_ATTACH=getBidPblancListInfoEorderAtchFileInfo
G2B_PAGE_SIZE=100
G2B_MAX_PAGES=20
G2B_TIMEOUT_SECONDS=30

# 키가 준비되기 전에는 세 단계를 mock으로 유지합니다.
# 실호출 전환값: STAGE2_PROVIDER=gemini, STAGE3_PRIMARY_PROVIDER=openai,
# STAGE3_FALLBACK_PROVIDER=nvidia
STAGE2_PROVIDER=mock
STAGE2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
STAGE2_MODEL=gemini-2.5-flash-lite
STAGE2_TIMEOUT_SECONDS=90
STAGE2_MAX_INPUT_CHARS=8000

STAGE3_PRIMARY_PROVIDER=mock
STAGE3_PRIMARY_BASE_URL=https://api.openai.com/v1
STAGE3_PRIMARY_MODEL=gpt-5.4-mini
STAGE3_PRIMARY_REASONING_EFFORT=medium

STAGE3_FALLBACK_PROVIDER=mock
STAGE3_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
STAGE3_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
STAGE3_TIMEOUT_SECONDS=180
STAGE3_MAX_INPUT_CHARS=100000
STAGE3_DAILY_LIMIT=10
STAGE3_MAX_CONCURRENCY=1

# 표준 키 이름. 단계별 STAGE2_API_KEY/STAGE3_*_API_KEY로 덮어쓸 수도 있습니다.
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

COLLECT_LOOKBACK_DAYS=3
DAILY_REPORT_HOUR=8
MAX_FILES_PER_NOTICE=20
MAX_FILE_SIZE_MB=80
HIGH_BUDGET_REVIEW_WON=100000000
DOWNLOAD_ALLOWED_HOSTS=apis.data.go.kr,nopenapi.g2b.go.kr,g2b.go.kr,www.g2b.go.kr

# 값을 지정하면 health/static 이외 모든 화면과 API에 HTTP Basic 또는 Bearer 인증이 필요합니다.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN=
AUTO_SEED_SAMPLE=true

# Linux bind mount 권한용. id -u / id -g 결과가 1000이 아니면 변경합니다.
LOCAL_UID=1000
LOCAL_GID=1000
