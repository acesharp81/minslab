APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Asia/Seoul
# Supabase 장애/오프라인 시에도 수집 결과를 잃지 않는 PoC08 전용 로컬 캐시입니다.
DATABASE_URL=sqlite:///./data/supabase-cache.db
DATA_DIR=./data
LOG_LEVEL=INFO

# 기존 서비스와 같은 Supabase Data API 자격정보만 사용합니다. DB 비밀번호/Pooler URI는 필요 없습니다.
SUPABASE2_URL=
SUPABASE2_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_SECONDS=15

# mock이면 키 없이 샘플 5건으로 전체 흐름을 실행합니다. live 전환 전 활용신청이 필요합니다.
G2B_MODE=mock
G2B_SERVICE_KEY=
G2B_BASE_URL_PRENOTICE=https://apis.data.go.kr/1230000/ao/HrcspSsstndrdInfoService
G2B_OPERATION_PRENOTICE=getPublicPrcureThngInfoServc
G2B_OPERATION_PRENOTICE_OPINION=getPublicPrcureThngOpinionInfoServc
G2B_BASE_URL_BID=https://apis.data.go.kr/1230000/ad/BidPublicInfoService
G2B_OPERATION_BID=getBidPblancListInfoServc
G2B_OPERATION_BID_ATTACH=getBidPblancListInfoEorderAtchFileInfo
G2B_PAGE_SIZE=100
G2B_MAX_PAGES=20
G2B_TIMEOUT_SECONDS=30

# 1차 의미 분류: Upstage를 주 공급자로, Mistral을 장애 시 fallback으로 사용합니다.
STAGE2_PROVIDER=upstage
STAGE2_BASE_URL=https://api.upstage.ai/v1
STAGE2_MODEL=solar-pro4
STAGE2_TIMEOUT_SECONDS=90
STAGE2_MAX_INPUT_CHARS=8000
STAGE2_MIN_INTERVAL_SECONDS=0
STAGE2_FALLBACK_PROVIDER=mistral
STAGE2_FALLBACK_BASE_URL=https://api.mistral.ai/v1
STAGE2_FALLBACK_MODEL=mistral-small-latest
STAGE2_FALLBACK_MIN_INTERVAL_SECONDS=0

# JEV는 기존 판정을 변경하지 않고 병행 결과만 analysis_runs에 기록합니다.
# API 키가 없으면 자동으로 건너뛰며 본 분석은 계속 진행됩니다.
JEV_SHADOW_ENABLED=true
JEV_BASE_URL=https://www.jevai.org
JEV_MODEL=typesafe-ai/jev
JEV_API_KEY=
# 임시 키의 사용 종료일(한국시간, 당일 포함). 이후 JEV 호출을 자동 중단합니다.
JEV_SHADOW_END_DATE=2026-09-25
JEV_TIMEOUT_SECONDS=20
JEV_MAX_INPUT_CHARS=8000

# PoC 4 중단 후 확보된 모델을 심층 분석에 재배치합니다.
STAGE3_PRIMARY_PROVIDER=openai
STAGE3_PRIMARY_BASE_URL=https://api.openai.com/v1
STAGE3_PRIMARY_MODEL=gpt-5.4-mini
STAGE3_PRIMARY_REASONING_EFFORT=low

STAGE3_FALLBACK_PROVIDER=nvidia
STAGE3_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
STAGE3_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# balanced는 공고별로 두 모델을 안정적으로 반반 배분하고 서로 장애 대체합니다.
STAGE3_ROUTING_MODE=balanced
STAGE3_TIMEOUT_SECONDS=180
STAGE3_MAX_INPUT_CHARS=100000
# 0은 일일 하드 제한 없음. 공급자 자체 속도 제한과 단일 동시성으로 보호합니다.
STAGE3_DAILY_LIMIT=0
STAGE3_MAX_CONCURRENCY=1

# 표준 키 이름. 단계별 STAGE2_API_KEY/STAGE3_*_API_KEY로 덮어쓸 수도 있습니다.
GEMINI_API_KEY=
UPSTAGE_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

COLLECT_LOOKBACK_DAYS=1
DAILY_REPORT_HOUR=6
MAX_FILES_PER_NOTICE=20
MAX_FILE_SIZE_MB=80
# Docker 이미지에는 체크섬을 검증한 hwp-cli v0.17.0이 포함됩니다.
HWP_CLI_PATH=/usr/local/bin/hwp
HWP_PARSE_TIMEOUT_SECONDS=30
HWP_PARSE_MAX_OUTPUT_MB=10
HIGH_BUDGET_REVIEW_WON=100000000
DOWNLOAD_ALLOWED_HOSTS=apis.data.go.kr,nopenapi.g2b.go.kr,g2b.go.kr,www.g2b.go.kr

# 값을 지정하면 health/static 이외 모든 화면과 API에 HTTP Basic 또는 Bearer 인증이 필요합니다.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN=
AUTO_SEED_SAMPLE=true

# Linux bind mount 권한용. id -u / id -g 결과가 1000이 아니면 변경합니다.
LOCAL_UID=1000
LOCAL_GID=1000
