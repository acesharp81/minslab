[Unit]
Description=PoC08 AI common platform radar primary collection
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec poc08-ai-common-platform-radar /usr/bin/nice -n 10 /usr/bin/ionice -c 2 -n 7 /usr/bin/timeout --signal=TERM --kill-after=30s 75m python scripts/run_operational_batch.py --phase primary
TimeoutStartSec=4600
